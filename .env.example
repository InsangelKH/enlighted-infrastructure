# Read by docker-compose.yml (docker compose auto-loads .env from this directory).
# Passwords for the Postgres roles created by postgres/init/01-roles.sh.
# Change these for anything beyond local dev.
APP_ADMIN_PASSWORD=app_admin_dev_password
APP_READWRITE_PASSWORD=app_readwrite_dev_password
APP_READONLY_PASSWORD=app_readonly_dev_password
